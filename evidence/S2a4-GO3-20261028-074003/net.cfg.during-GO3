# LongYinCoop S2 net config -- flat key = value (MelonLoader never reads/writes this file)
# enabled=false by default; flip to true only for a measurement session
enabled          = true
role             = host
secret           = <redacted>
allowNonLoopback = false
transport        = tcp
bind             = 127.0.0.1
port             = 47800
sendHz           = 30
heartbeatMs      = 1000
overlay          = true
