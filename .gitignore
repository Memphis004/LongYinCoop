# --- build output ---
bin/
obj/
*.user
.vs/

# --- game assets: NEVER commit ---
GameAssembly.dll
UnityPlayer.dll
UnityCrashHandler64.exe
baselib.dll
version.dll
LongYinLiZhiZhuan.exe
LongYinLiZhiZhuan_Data/
MelonLoader/
Mods/
