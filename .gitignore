# --- build output ---
bin/
obj/
*.user
.vs/

# --- game assets: NEVER commit ---
GameAssembly.dll
UnityPlayer.dll
UnityCrashHandler64.exe
baselib.dll
version.dll
LongYinLiZhiZhuan.exe
LongYinLiZhiZhuan_Data/
MelonLoader/
Mods/
UserData/
UserLibs/
Plugins/
Il2CppDumper/
dump.cs
il2cpp.h
Il2CppAssemblies/
global-metadata.dat
*.dll.off

# --- local test artifacts ---
# Save copies, recorder streams and logs stay local. Only the small audit
# records (hash lists, rebaseline/approval notes) are tracked, so baseline
# history is reviewable in git without ever committing a save.
coop-test/**
!coop-test/*/
!coop-test/*/*/
!coop-test/**/savehash.real.before.txt
!coop-test/**/savehash.copy.before.txt
!coop-test/**/savehash.*.txt.note
!coop-test/**/AUDIT.json
!coop-test/**/APPROVAL.md
coop-test/**/save/
coop-test/**/Save.used-*/
coop-test/**/Save.real-*/
coop-test/**/__pycache__/
# raw generated records embed absolute local paths (C:\\Users\\<name>): they
# stay local, the sanitized AUDIT.json is what git tracks (tools/coop-audit.py)
coop-test/**/REBASELINE.json
coop-test/**/MANIFEST.json
*.log
s0-result.json
compat-notes.local.md

# python
__pycache__/
*.pyc

# keep evidence small: big runtime logs stay local
evidence/**/coop-run.log
!evidence/**/s0-result.json

# raw status streams are large runtime logs (75MB) - keep local, aggregates live in the reports
evidence/**/*.ndjson

# binary drops inside evidence stay local
evidence/**/*.dll
# (ค) 2026-10-29 ตามมติผู้ใช้ — PDB ของ build และสำเนา pref binary ไม่เข้า git
# (ถอนจาก index ด้วย git rm --cached แล้ว — ไฟล์บนดิสก์คงอยู่)
evidence/**/*.pdb
PlayerprefData.dat.*

# SP5body: full-binary disasm of GameAssembly.dll (471MB, game-derived dump)
# stays local per the never-commit rule for game assets; the extracted bodies
# (target-bodies.disasm.txt), TSVs and reports are what git tracks.
evidence/**/gameassembly.disasm.txt
