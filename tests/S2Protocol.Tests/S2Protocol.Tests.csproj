<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>S2Protocol.Tests</AssemblyName>
    <RootNamespace>LongYinCoop.S2.Tests</RootNamespace>
  </PropertyGroup>

  <!-- T0/T1: codec/protocol + S2a-2 pure host pieces. The mod sources are linked
       read-only; no packages. IL2CPP-dependent files (S2/Host/S2Sampler.cs,
       S2/S2HostService.cs, CoopMod.cs) are intentionally NOT linked. -->
  <ItemGroup>
    <Compile Include="..\..\src\LongYinCoop\S2\Protocol\**\*.cs" LinkBase="Protocol" />
    <Compile Include="..\..\src\LongYinCoop\S2\Transport\**\*.cs" LinkBase="Transport" />
    <Compile Include="..\..\src\LongYinCoop\S2\Host\S2Snapshot.cs" LinkBase="Host" />
    <Compile Include="..\..\src\LongYinCoop\S2\Host\S2Counters.cs" LinkBase="Host" />
    <Compile Include="..\..\src\LongYinCoop\S2\Host\S2Sender.cs" LinkBase="Host" />
    <Compile Include="..\..\src\LongYinCoop\S2\Host\S2PhaseStats.cs" LinkBase="Host" />
    <Compile Include="..\..\src\LongYinCoop\S2\Host\S2SelfTest.cs" LinkBase="Host" />
    <Compile Include="..\..\src\LongYinCoop\S2\Host\S2WriteGuard.cs" LinkBase="Host" />
    <Compile Include="..\..\src\LongYinCoop\S2\S2NetConfig.cs" LinkBase="S2" />
    <!-- งาน A: path ของ net.cfg (pure: System + System.IO เท่านั้น) -->
    <Compile Include="..\..\src\LongYinCoop\CoopPaths.cs" LinkBase="Mod" />
  </ItemGroup>

  <ItemGroup>
    <!-- fixture (pre-edit TurnGate.cs) is a .txt so the default glob cannot compile it -->
    <None Include="fixtures\**\*" />
  </ItemGroup>

</Project>
