<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>S2Protocol.Tests</AssemblyName>
    <RootNamespace>LongYinCoop.S2.Tests</RootNamespace>
  </PropertyGroup>

  <!-- T0/T1: codec/protocol + S2a-2 pure host pieces. The mod sources are linked
       read-only; no packages. IL2CPP-dependent files (S2/Host/S2Sampler.cs,
       S2/S2HostService.cs, CoopMod.cs) are intentionally NOT linked. -->
  <ItemGroup>
    <Compile Include="..\..\src\LongYinCoop\S2\Protocol\**\*.cs" LinkBase="Protocol" />
    <Compile Include="..\..\src\LongYinCoop\S2\Transport\**\*.cs" LinkBase="Transport" />
    <Compile Include="..\..\src\LongYinCoop\S2\Host\S2Snapshot.cs" LinkBase="Host" />
    <Compile Include="..\..\src\LongYinCoop\S2\Host\S2Counters.cs" LinkBase="Host" />
    <Compile Include="..\..\src\LongYinCoop\S2\Host\S2Sender.cs" LinkBase="Host" />
    <Compile Include="..\..\src\LongYinCoop\S2\Host\S2PhaseStats.cs" LinkBase="Host" />
    <Compile Include="..\..\src\LongYinCoop\S2\Host\S2SelfTest.cs" LinkBase="Host" />
    <Compile Include="..\..\src\LongYinCoop\S2\Host\S2WriteGuard.cs" LinkBase="Host" />
    <!-- S2a-4 W4(c): ตรรกะ flag แบบ pure ของ WriteGuard hook (ไม่มี call site นอก tests — บังคับโดย s2_static_check.py) -->
    <Compile Include="..\..\src\LongYinCoop\S2\Host\S2WriteGuardHook.cs" LinkBase="Host" />
    <!-- S2a-4 W5: gate ของ set_pref (pure — IpcServer เป็นผู้เรียก) -->
    <Compile Include="..\..\src\LongYinCoop\S2\Host\S2SetPrefGate.cs" LinkBase="Host" />
    <!-- S2a-3 (Pure, no Unity): control flow / frame meter / tcp self-test -->
    <Compile Include="..\..\src\LongYinCoop\S2\Host\S2ControlHandler.cs" LinkBase="Host" />
    <Compile Include="..\..\src\LongYinCoop\S2\Host\S2FrameMeter.cs" LinkBase="Host" />
    <Compile Include="..\..\src\LongYinCoop\S2\Host\S2TcpSelfTest.cs" LinkBase="Host" />
    <Compile Include="..\..\src\LongYinCoop\S2\S2NetConfig.cs" LinkBase="S2" />
    <!-- งาน A: path ของ net.cfg (pure: System + System.IO เท่านั้น) -->
    <Compile Include="..\..\src\LongYinCoop\CoopPaths.cs" LinkBase="Mod" />
    <!-- S2a-4 W3: template ข้อความ overlay (pure consts — ใช้โดย S2OverlayText) -->
    <Compile Include="..\..\src\LongYinCoop\UIStrings.cs" LinkBase="Mod" />
    <!-- S3 prerequisite (รีวิวรอบ 3): AliveRule pure — ใช้ทั้งใน mod และ table unit test -->
    <Compile Include="..\..\src\LongYinCoop\S3\AliveRule.cs" LinkBase="S3" />
    <!-- NEG20 follow-up: RangeCells pure — expose attack range cells (status) -->
    <Compile Include="..\..\src\LongYinCoop\S3\RangeCells.cs" LinkBase="S3" />
    <!-- S2a-4: guest side (pure) — decoder (W1), overlay client (W2), render model (W3) -->
    <!-- (S2OverlayService.cs ไม่ถูกลิงก์: MelonEvents.OnGUI/GUI เป็นของ runtime — compile เฉพาะใน mod csproj) -->
    <Compile Include="..\..\src\LongYinCoop\S2\Guest\S2GuestDecoder.cs" LinkBase="Guest" />
    <Compile Include="..\..\src\LongYinCoop\S2\Guest\S2OverlayClient.cs" LinkBase="Guest" />
    <Compile Include="..\..\src\LongYinCoop\S2\Guest\S2OverlayRenderModel.cs" LinkBase="Guest" />
    <!-- V2-A (มติ V2A-4): ตรรกะ pure ของ sampler อ่านอย่างเดียว — TimeV2aSampler.cs ไม่ถูกลิงก์ (อ้าง Il2Cpp/Unity) -->
    <Compile Include="..\..\src\LongYinCoop\TimeV2a\TimeV2aRules.cs" LinkBase="TimeV2a" />
    <!-- SP5-NPC N1-5: predicate/policy pure (ไม่มี Unity) — Sp5NpcPolicy.cs -->
    <Compile Include="..\..\src\LongYinCoop\SP5\Sp5NpcPolicy.cs" LinkBase="SP5" />
    <!-- SP5-NPC N2: กฎคำนวณ gate แบบ pure — Sp5NpcGate.cs ไม่ลิงก์ (Il2Cpp/Harmony — compile เฉพาะ mod csproj) -->
    <Compile Include="..\..\src\LongYinCoop\SP5\Sp5NpcRules.cs" LinkBase="SP5" />
    <!-- SP5-NPC N4-follow-up (มติ 2026-10-30): กติกา match ชื่อ loveable (pure) — Sp5T0Probe.cs ไม่ลิงก์ (Il2Cpp/Harmony) -->
    <Compile Include="..\..\src\LongYinCoop\SP5\Sp5T0NameMatch.cs" LinkBase="SP5" />
  </ItemGroup>

  <ItemGroup>
    <!-- fixture (pre-edit TurnGate.cs) is a .txt so the default glob cannot compile it -->
    <!-- S2a-3: replica-vectors.ndjson ใช้ร่วมกับ tools/viewer-client.py (mode selftest) -->
    <None Include="fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
